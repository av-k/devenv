#!/usr/bin/env bash
# Launches a coding agent inside the sandbox, scoped to the current directory.
set -euo pipefail

# Where the launcher's own files live. This is deliberately not
# `dirname "${BASH_SOURCE[0]}"`: the documented install puts a symlink on PATH,
# and the symlink's directory holds neither allowlist.txt, nor .env.local, nor
# the Dockerfile that `--build` uses as its context.
#
# Resolved by hand rather than with `readlink -f` or `realpath`. Both are GNU
# coreutils; BSD readlink has historically had no -f at all, and macOS only
# gained compatible versions in 12.3. A fallback pair would mean two code paths
# where the rare one rots unnoticed. This loop needs only `readlink` with no
# options, which is POSIX, and it follows chains of symlinks and relative
# targets alike.
resolve_dir() {
    local src="$1" dir hops=0
    while [ -L "${src}" ]; do
        hops=$((hops + 1))
        if [ "${hops}" -gt 40 ]; then
            echo "devenv: symlink loop while resolving ${1}" >&2
            exit 1
        fi
        dir="$(cd -P "$(dirname "${src}")" && pwd)"
        src="$(readlink "${src}")"
        case "${src}" in
            /*) ;;                      # absolute target, take as given
            *)  src="${dir}/${src}" ;;  # relative to the link's own directory
        esac
    done
    cd -P "$(dirname "${src}")" && pwd
}

REPO_DIR="$(resolve_dir "${BASH_SOURCE[0]}")"

# Local settings. Anything wrong with this file is reported rather than
# skipped: silently running without the settings someone wrote down is how a
# misconfiguration turns into a mystery.
ENV_LOCAL="${REPO_DIR}/.env.local"
if [ -e "${ENV_LOCAL}" ]; then
    if [ ! -f "${ENV_LOCAL}" ]; then
        echo "devenv: ${ENV_LOCAL} is not a regular file." >&2
        exit 1
    elif [ ! -r "${ENV_LOCAL}" ]; then
        echo "devenv: ${ENV_LOCAL} is not readable; its settings would be" >&2
        echo "devenv: silently ignored. Check its permissions." >&2
        exit 1
    elif ! . "${ENV_LOCAL}"; then
        echo "devenv: ${ENV_LOCAL} could not be read; see the error above." >&2
        exit 1
    fi
fi

IMAGE="${DEVENV_IMAGE:-devenv:local}"
ALLOWLIST="${DEVENV_ALLOWLIST_FILE:-${REPO_DIR}/allowlist.txt}"
FIREWALL="on"

usage() {
    cat <<'EOF'
Usage: devenv [options] [command ...]

Runs a command inside the sandbox with the current directory mounted at /app.
With no command, opens a shell. Agents available inside: claude, codex, agy.

Options:
  --build        Build the image, then exit.
  --update       Rebuild without cache to pick up newer agent versions, then exit.
  --open         Start without the egress filter. Use deliberately.
  --versions     Print the tool versions baked into the image, then exit.
  -h, --help     Show this help.

Anything after '--' is passed to the container untouched.

Examples:
  devenv                     # shell in the sandbox
  devenv claude              # Claude Code, scoped to this directory
  devenv --open codex        # Codex with unrestricted network
EOF
}

# Everything below needs a working daemon. Checked separately from the image so
# an unreachable daemon is not reported as a missing image: that answer sends
# people off to run --build, which cannot work either, and hides the real
# cause - a stopped daemon, or an account that is not in the docker group.
require_docker() {
    local err
    if ! command -v docker >/dev/null 2>&1; then
        echo "devenv: docker is not on PATH." >&2
        exit 1
    fi
    if ! err="$(docker version --format '{{.Server.Version}}' 2>&1 >/dev/null)"; then
        echo "devenv: cannot reach the docker daemon. It reports:" >&2
        printf '  %s\n' "${err}" >&2
        exit 1
    fi
}

# Checked before any `docker run`, so a missing image is named as such instead
# of docker trying to pull devenv:local from a registry and answering with
# "pull access denied ... may require 'docker login'".
require_image() {
    if ! docker image inspect "${IMAGE}" >/dev/null 2>&1; then
        echo "devenv: image ${IMAGE} not found. Run 'devenv --build' first." >&2
        exit 1
    fi
}

build() {
    local extra=("$@")
    require_docker
    if [ ! -f "${REPO_DIR}/Dockerfile" ]; then
        echo "devenv: no Dockerfile in ${REPO_DIR}" >&2
        echo "devenv: the image is built from the launcher's own directory, so" >&2
        echo "devenv: it looks like the script was copied out of the clone on" >&2
        echo "devenv: its own. Symlink it instead of copying it." >&2
        exit 1
    fi
    echo "devenv: building ${IMAGE}"
    docker build "${extra[@]}" -t "${IMAGE}" "${REPO_DIR}"
    echo "devenv: done"
    docker run --rm --entrypoint cat "${IMAGE}" /opt/devenv/versions.txt
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --build)    build; exit 0 ;;
        --update)   build --no-cache --pull; exit 0 ;;
        --open)     FIREWALL="off"; shift ;;
        --versions) require_docker; require_image
                    docker run --rm --entrypoint cat "${IMAGE}" /opt/devenv/versions.txt; exit 0 ;;
        -h|--help)  usage; exit 0 ;;
        --)         shift; break ;;
        -*)         echo "devenv: unknown option '$1'" >&2; usage >&2; exit 1 ;;
        *)          break ;;
    esac
done

require_docker
require_image

# The allowlist is bind-mounted as a file. Docker does not check what it is
# being handed: pointed at a directory it mounts the directory, the filter then
# reads nothing, and the container reports an empty allowlist - which sends the
# search towards DNS and the file's contents rather than the mount. Each case
# gets its own message here, before docker is involved.
if [ -L "${ALLOWLIST}" ] && [ ! -e "${ALLOWLIST}" ]; then
    echo "devenv: the allowlist at ${ALLOWLIST} is a broken symlink." >&2
    echo "devenv: it points at $(readlink "${ALLOWLIST}"), which does not exist." >&2
    exit 1
elif [ ! -e "${ALLOWLIST}" ]; then
    echo "devenv: no allowlist at ${ALLOWLIST}" >&2
    echo "devenv: expected allowlist.txt beside the launcher, or" >&2
    echo "devenv: DEVENV_ALLOWLIST_FILE pointing at one." >&2
    exit 1
elif [ -d "${ALLOWLIST}" ]; then
    echo "devenv: the allowlist path ${ALLOWLIST} is a directory, not a file." >&2
    echo "devenv: docker would mount it without complaint and the filter would" >&2
    echo "devenv: come up empty. Point it at allowlist.txt itself." >&2
    exit 1
elif [ ! -f "${ALLOWLIST}" ]; then
    echo "devenv: the allowlist at ${ALLOWLIST} is not a regular file." >&2
    exit 1
elif [ ! -r "${ALLOWLIST}" ]; then
    echo "devenv: the allowlist at ${ALLOWLIST} is not readable." >&2
    echo "devenv: check its permissions and those of the directories above it." >&2
    exit 1
fi

WORKDIR="$(pwd)"
LABEL="devenv=${WORKDIR}"

# One session per directory. Two agents sharing a working tree corrupt each
# other's edits.
if [ -n "$(docker ps -q --filter "label=${LABEL}")" ]; then
    echo "devenv: a session is already running for ${WORKDIR}" >&2
    echo "devenv: use a separate git worktree for a second agent." >&2
    exit 1
fi

CAPS=()
if [ "${FIREWALL}" = "on" ]; then
    CAPS=(--cap-add=NET_ADMIN --cap-add=NET_RAW)
else
    echo "devenv: starting WITHOUT the egress filter" >&2
fi

# Converts a docker size (8g, 512m, 1024) to bytes. Fails on anything docker
# would not accept, so the launcher can name the variable at fault instead of
# leaving docker to answer "see usage".
to_bytes() {
    local value number unit
    value="$(printf '%s' "${1}" | tr 'A-Z' 'a-z')"
    [[ "${value}" =~ ^([0-9]+)(b|k|m|g|kb|mb|gb)?$ ]] || return 1
    number="${BASH_REMATCH[1]}"
    unit="${BASH_REMATCH[2]:-}"
    case "${unit}" in
        ''|b)  echo "${number}" ;;
        k|kb)  echo $(( number * 1024 )) ;;
        m|mb)  echo $(( number * 1024 * 1024 )) ;;
        g|gb)  echo $(( number * 1024 * 1024 * 1024 )) ;;
    esac
}

# Resource limits. Unset means unlimited, which is the default: an empty value
# must not reach docker, which rejects '--cpus=' outright.
LIMITS=()
[ -n "${DEVENV_CPUS:-}" ] && LIMITS+=(--cpus="${DEVENV_CPUS}")
[ -n "${DEVENV_PIDS:-}" ] && LIMITS+=(--pids-limit="${DEVENV_PIDS}")

if [ -n "${DEVENV_MEMORY_SWAP:-}" ] && [ -z "${DEVENV_MEMORY:-}" ]; then
    echo "devenv: DEVENV_MEMORY_SWAP is set but DEVENV_MEMORY is not." >&2
    echo "devenv: docker's swap limit is the total of memory plus swap, so it" >&2
    echo "devenv: means nothing without a memory limit to be the total of." >&2
    exit 1
fi

if [ -n "${DEVENV_MEMORY:-}" ]; then
    if ! MEMORY_BYTES="$(to_bytes "${DEVENV_MEMORY}")"; then
        echo "devenv: DEVENV_MEMORY='${DEVENV_MEMORY}' is not a size docker accepts." >&2
        echo "devenv: use a whole number with an optional unit: 8g, 512m, 1024." >&2
        exit 1
    fi

    # Swap defaults to the memory limit, which switches swap off. Docker's own
    # default is to allow the same amount again as swap, so DEVENV_MEMORY=8g
    # would mean 8 GiB of RAM plus 8 GiB of disk - a ceiling that hides
    # thrashing rather than preventing it.
    MEMORY_SWAP="${DEVENV_MEMORY_SWAP:-${DEVENV_MEMORY}}"

    if [ "${MEMORY_SWAP}" != "-1" ]; then
        if ! SWAP_BYTES="$(to_bytes "${MEMORY_SWAP}")"; then
            echo "devenv: DEVENV_MEMORY_SWAP='${MEMORY_SWAP}' is not a size docker accepts." >&2
            echo "devenv: use a whole number with an optional unit (8g, 512m, 1024)," >&2
            echo "devenv: or -1 for unlimited swap." >&2
            exit 1
        fi
        if [ "${SWAP_BYTES}" -lt "${MEMORY_BYTES}" ]; then
            echo "devenv: DEVENV_MEMORY_SWAP (${MEMORY_SWAP}) is below DEVENV_MEMORY (${DEVENV_MEMORY})." >&2
            echo "devenv: the swap limit is the total of memory plus swap, so it can" >&2
            echo "devenv: never be the smaller of the two. Set it equal to" >&2
            echo "devenv: DEVENV_MEMORY for no swap at all, higher to allow that" >&2
            echo "devenv: much in total, or -1 for unlimited." >&2
            exit 1
        fi
    fi

    LIMITS+=(--memory="${DEVENV_MEMORY}" --memory-swap="${MEMORY_SWAP}")
fi

[ ${#LIMITS[@]} -gt 0 ] && echo "devenv: limits: ${LIMITS[*]}" >&2

# SELinux hosts need a relabel option on bind mounts or the container cannot
# read the project directory. Empty by default, which leaves the mount strings
# byte-for-byte as they were.
MOUNT_SUFFIX="${DEVENV_MOUNT_SUFFIX:-}"
if [ -n "${MOUNT_SUFFIX}" ] && [ "${MOUNT_SUFFIX#:}" = "${MOUNT_SUFFIX}" ]; then
    echo "devenv: DEVENV_MOUNT_SUFFIX must start with a colon, e.g. ':z'." >&2
    echo "devenv: without one the value would be glued onto the mount path." >&2
    exit 1
fi

# The allowlist mount already carries an option, and docker separates those
# with commas rather than colons: ':ro,z', not ':ro:z'.
ALLOWLIST_OPTS=":ro${MOUNT_SUFFIX:+,${MOUNT_SUFFIX#:}}"

exec docker run --rm -it --init \
    --label "${LABEL}" \
    --hostname devenv \
    -v "${WORKDIR}:/app${MOUNT_SUFFIX}" \
    -v devenv-claude:/home/node/.claude \
    -v devenv-codex:/home/node/.codex \
    -v devenv-gemini:/home/node/.gemini \
    -v "${ALLOWLIST}:/etc/devenv/allowlist.txt${ALLOWLIST_OPTS}" \
    -e "DEVENV_FIREWALL=${FIREWALL}" \
    -e "DEVENV_AGENT=${DEVENV_AGENT:-}" \
    -e "TERM=${TERM:-xterm-256color}" \
    "${CAPS[@]}" \
    "${LIMITS[@]}" \
    "${IMAGE}" \
    "${@:-bash}"
