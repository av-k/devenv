#!/usr/bin/env bash
# Launches a coding agent inside the sandbox, scoped to the current directory.
set -euo pipefail

# Where the launcher's own files live. This is deliberately not
# `dirname "${BASH_SOURCE[0]}"`: the documented install puts a symlink on PATH,
# and the symlink's directory holds neither allowlist.txt, nor .env.local, nor
# the Dockerfile that `--build` uses as its context.
#
# Resolved by hand rather than with `readlink -f` or `realpath`. Both are GNU
# coreutils; BSD readlink has historically had no -f at all, and macOS only
# gained compatible versions in 12.3. A fallback pair would mean two code paths
# where the rare one rots unnoticed. This loop needs only `readlink` with no
# options, which is POSIX, and it follows chains of symlinks and relative
# targets alike.
resolve_dir() {
    local src="$1" dir hops=0
    while [ -L "${src}" ]; do
        hops=$((hops + 1))
        if [ "${hops}" -gt 40 ]; then
            echo "devenv: symlink loop while resolving ${1}" >&2
            exit 1
        fi
        dir="$(cd -P "$(dirname "${src}")" && pwd)"
        src="$(readlink "${src}")"
        case "${src}" in
            /*) ;;                      # absolute target, take as given
            *)  src="${dir}/${src}" ;;  # relative to the link's own directory
        esac
    done
    cd -P "$(dirname "${src}")" && pwd
}

REPO_DIR="$(resolve_dir "${BASH_SOURCE[0]}")"

# Local settings. Anything wrong with this file is reported rather than
# skipped: silently running without the settings someone wrote down is how a
# misconfiguration turns into a mystery.
ENV_LOCAL="${REPO_DIR}/.env.local"
if [ -e "${ENV_LOCAL}" ]; then
    if [ ! -f "${ENV_LOCAL}" ]; then
        echo "devenv: ${ENV_LOCAL} is not a regular file." >&2
        exit 1
    elif [ ! -r "${ENV_LOCAL}" ]; then
        echo "devenv: ${ENV_LOCAL} is not readable; its settings would be" >&2
        echo "devenv: silently ignored. Check its permissions." >&2
        exit 1
    elif ! . "${ENV_LOCAL}"; then
        echo "devenv: ${ENV_LOCAL} could not be read; see the error above." >&2
        exit 1
    fi
fi

IMAGE="${DEVENV_IMAGE:-devenv:local}"
ALLOWLIST="${DEVENV_ALLOWLIST_FILE:-${REPO_DIR}/allowlist.txt}"
FIREWALL="on"
NESTED="off"
ADDONS=()
ACTION=""

# docker run options declared by the add-ons' run.conf; see read_run_conf.
ADDON_RUN=()
RUN_HOSTS=()
SHM_SIZE=""
SHM_BYTES=0
SHM_FROM=""
SHM_COUNT=0
SHM_LIST=""

# An add-on's name becomes both a path under addons/ and part of an image tag,
# so it is held to a shape that is safe as either: no '/', no '.', nothing that
# could walk out of addons/ or split the tag. Kept in a variable because a
# quoted pattern on the right of =~ is matched literally since bash 3.2.
#
# '_' is left out on purpose: it is the separator between names in the tag
# (devenv:local_a_b), and only because no name can contain it does a tag map
# back to exactly one set of add-ons. Allow '_' here and `--with a_b` collides
# with `--with a --with b` again - both would build and run devenv:local_a_b.
ADDON_NAME_RE='^[a-z0-9][a-z0-9-]*$'

usage() {
    cat <<'EOF'
Usage: devenv [options] [command ...]

Runs a command inside the sandbox with the current directory mounted at /app.
With no command, opens a shell. Agents available inside: claude, codex, agy.

Options:
  --build        Build the image, then exit.
  --update       Rebuild the agents at their latest versions, then exit.
  --open         Start without the egress filter. Use deliberately.
  --nested-sandbox
                 Allow user namespaces, so an agent's own sandbox can run.
                 Turns off the seccomp filter for the session; read the
                 README before using it.
  --versions     Print the tool versions baked into the image, then exit.
  --with NAME    Add the add-on in addons/NAME on top of the image, for this
                 run only. Repeatable. With --build or --update, builds it.
  -h, --help     Show this help.

Anything after '--' is passed to the container untouched.

Examples:
  devenv                     # shell in the sandbox
  devenv claude              # Claude Code, scoped to this directory
  devenv --open codex        # Codex with unrestricted network
EOF
}

# Everything below needs a working daemon. Checked separately from the image so
# an unreachable daemon is not reported as a missing image: that answer sends
# people off to run --build, which cannot work either, and hides the real
# cause - a stopped daemon, or an account that is not in the docker group.
require_docker() {
    local err
    if ! command -v docker >/dev/null 2>&1; then
        echo "devenv: docker is not on PATH." >&2
        exit 1
    fi
    if ! err="$(docker version --format '{{.Server.Version}}' 2>&1 >/dev/null)"; then
        echo "devenv: cannot reach the docker daemon. It reports:" >&2
        printf '  %s\n' "${err}" >&2
        exit 1
    fi
}

# Checked before any `docker run`, so a missing image is named as such instead
# of docker trying to pull devenv:local from a registry and answering with
# "pull access denied ... may require 'docker login'".
require_image() {
    if ! docker image inspect "${SESSION_IMAGE}" >/dev/null 2>&1; then
        echo "devenv: image ${SESSION_IMAGE} not found. Run 'devenv --build${WITH_FLAGS}' first." >&2
        exit 1
    fi
}

add_addon() {
    local name="$1"
    if [[ ! "${name}" =~ ${ADDON_NAME_RE} ]]; then
        echo "devenv: '${name}' is not a valid add-on name." >&2
        echo "devenv: use lowercase letters, digits and '-', starting with a" >&2
        echo "devenv: letter or digit." >&2
        exit 1
    fi
    if [ ! -f "${REPO_DIR}/addons/${name}/Dockerfile" ]; then
        echo "devenv: no add-on '${name}': expected ${REPO_DIR}/addons/${name}/Dockerfile" >&2
        exit 1
    fi
    ADDONS+=("${name}")
}

missing_addon_name() {
    echo "devenv: --with needs an add-on name, e.g. '--with playwright'." >&2
    exit 1
}

# Actions run once every flag has been read, so `--build --with x` builds x as
# well. Two of them would have the first silently win, so that is refused.
set_action() {
    if [ -n "${ACTION}" ] && [ "${ACTION}" != "$1" ]; then
        echo "devenv: --${ACTION} and --$1 cannot be combined." >&2
        exit 1
    fi
    ACTION="$1"
}

build_image() {
    local tag="$1" context="$2"
    shift 2
    echo "devenv: building ${tag}"
    docker build "$@" -t "${tag}" "${context}"
}

# Builds the base with the options given, then each add-on on top of the one
# before it. The options are the base's alone: --pull in particular would send
# an add-on looking for its FROM - a local image - in a registry, and fail.
# An add-on needs no cache option of its own either: a rebuilt base has a new
# ID, so its FROM changes and its layers miss the cache anyway.
#
# Each add-on's context is its own directory, so its build sees its own files
# and nothing of the repository's, .env.local included.
#
# Every add-on image is labelled with the ID of the base it was built on. A
# later --update without --with replaces the base and leaves the add-on images
# where they were, still holding the old agents; the label is how a session
# started with --with notices (see check_addon_base).
build() {
    local tag="${IMAGE}" name base_id
    require_docker
    if [ ! -f "${REPO_DIR}/Dockerfile" ]; then
        echo "devenv: no Dockerfile in ${REPO_DIR}" >&2
        echo "devenv: the image is built from the launcher's own directory, so" >&2
        echo "devenv: it looks like the script was copied out of the clone on" >&2
        echo "devenv: its own. Symlink it instead of copying it." >&2
        exit 1
    fi
    build_image "${IMAGE}" "${REPO_DIR}" "$@"
    if [ ${#ADDONS[@]} -gt 0 ]; then
        base_id="$(docker image inspect -f '{{.Id}}' "${IMAGE}")"
        for name in "${ADDONS[@]}"; do
            build_image "${tag}_${name}" "${REPO_DIR}/addons/${name}" \
                --build-arg "BASE_IMAGE=${tag}" \
                --label "devenv.base-id=${base_id}"
            tag="${tag}_${name}"
        done
    fi
    echo "devenv: done"
    docker run --rm --entrypoint cat "${SESSION_IMAGE}" /opt/devenv/versions.txt
}

# The AGENTS_REFRESH value the current image was built with, empty if there is
# no image or it predates the label. Passing it back keeps a plain --build on
# that image's agent layers; without it the build would match whichever cached
# layers were built with the default, which after an --update are older ones.
image_refresh() {
    image_label "${IMAGE}" devenv.agents-refresh
}

# A label's value on an image, empty if the image or the label is missing.
# A missing label prints "<no value>" rather than failing, hence the check.
image_label() {
    local value
    value="$(docker image inspect \
        --format "{{ index .Config.Labels \"$2\" }}" \
        "$1" 2>/dev/null)" || value=""
    [ "${value}" = "<no value>" ] && value=""
    printf '%s' "${value}"
}

# Warns, without stopping the session, when the add-on image was not built on
# the base image as it is now. The usual cause is `devenv --update` without
# --with: it replaces the base and leaves the add-on images on the old one, so
# the session would quietly run the agents from before the update. A plain
# --build with the same add-ons fixes it: the base comes from cache, and the
# add-ons rebuild because their FROM has changed.
#
# Not an error: the image works, it is only older than expected, and refusing
# to start would turn an out-of-date image into a blocked one.
check_addon_base() {
    local base_id built_on
    base_id="$(docker image inspect -f '{{.Id}}' "${IMAGE}" 2>/dev/null)" || base_id=""
    built_on="$(image_label "${SESSION_IMAGE}" devenv.base-id)"
    if [ -z "${base_id}" ]; then
        echo "devenv: base image ${IMAGE} is not present, so ${SESSION_IMAGE}" >&2
        echo "devenv: cannot be checked against it and may hold older agents." >&2
    elif [ -z "${built_on}" ]; then
        echo "devenv: ${SESSION_IMAGE} has no record of the base it was built on" >&2
        echo "devenv: (built by an older launcher) and may hold older agents." >&2
    elif [ "${built_on}" != "${base_id}" ]; then
        echo "devenv: ${SESSION_IMAGE} was built on an older ${IMAGE}, so its" >&2
        echo "devenv: agents are the ones from before the base was last rebuilt." >&2
    else
        return 0
    fi
    echo "devenv: rebuild it with: devenv --build${WITH_FLAGS}" >&2
}

# Converts a docker size (8g, 512m, 1024) to bytes. Fails on anything docker
# would not accept, so the launcher can name the variable at fault instead of
# leaving docker to answer "see usage".
to_bytes() {
    local value number unit
    value="$(printf '%s' "${1}" | tr 'A-Z' 'a-z')"
    [[ "${value}" =~ ^([0-9]+)(b|k|m|g|kb|mb|gb)?$ ]] || return 1
    number="${BASH_REMATCH[1]}"
    unit="${BASH_REMATCH[2]:-}"
    case "${unit}" in
        ''|b)  echo "${number}" ;;
        k|kb)  echo $(( number * 1024 )) ;;
        m|mb)  echo $(( number * 1024 * 1024 )) ;;
        g|gb)  echo $(( number * 1024 * 1024 * 1024 )) ;;
    esac
}

trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "${s}"
}

# What an add-on may ask of `docker run`, read from addons/<name>/run.conf.
#
# The file declares values for a closed set of keys, and the launcher writes
# the flags itself. It is deliberately not a list of flags to pass through: any
# pass-through, however filtered, is a way to --privileged, --cap-add, -v,
# --security-opt or --network, each of which undoes part of the sandbox from a
# file that looks like configuration. A key that is not known is an error
# rather than skipped, so a typo or a wish for more is seen instead of quietly
# not applying. New keys are added here one at a time, each with its own check.
#
# The file is read line by line as data - never sourced, evaluated or expanded
# - and every value is matched against a pattern before it goes anywhere near
# the command line.
#
#   shm_size=<size>                  --shm-size; the largest across add-ons wins
#   add_host=<hostname>:host-gateway --add-host; repeatable, merged across
#                                    add-ons. Only host-gateway, never an
#                                    address: an arbitrary IP would let an
#                                    add-on redirect a name the allowlist trusts.
ADD_HOST_RE='^[a-z0-9]([a-z0-9.-]*[a-z0-9])?:host-gateway$'

add_run_host() {
    local host
    if [ ${#RUN_HOSTS[@]} -gt 0 ]; then
        for host in "${RUN_HOSTS[@]}"; do
            [ "${host}" = "$1" ] && return 0
        done
    fi
    RUN_HOSTS+=("$1")
}

run_conf_error() {
    echo "devenv: add-on '$1', run.conf line $2: $3" >&2
    echo "devenv: $4" >&2
    exit 1
}

read_run_conf() {
    local name="$1" file="${REPO_DIR}/addons/$1/run.conf"
    local line text key value bytes n=0 have_shm="" adds=()
    [ -e "${file}" ] || return 0
    if [ ! -f "${file}" ] || [ ! -r "${file}" ]; then
        echo "devenv: add-on '${name}': ${file} is not a readable regular file." >&2
        exit 1
    fi
    while IFS= read -r line || [ -n "${line}" ]; do
        n=$((n + 1))
        text="$(trim "${line}")"
        case "${text}" in
            ''|'#'*) continue ;;
            *=*)     ;;
            *)       run_conf_error "${name}" "${n}" "${text}" \
                         "expected key=value." ;;
        esac
        key="$(trim "${text%%=*}")"
        value="$(trim "${text#*=}")"
        case "${key}" in
            shm_size)
                if [ -n "${have_shm}" ]; then
                    run_conf_error "${name}" "${n}" "${text}" \
                        "shm_size is already set on line ${have_shm}."
                fi
                if ! bytes="$(to_bytes "${value}")"; then
                    run_conf_error "${name}" "${n}" "${text}" \
                        "shm_size takes a size: a whole number with an optional unit, e.g. 1g, 512m."
                fi
                have_shm="${n}"
                adds+=(--shm-size="${value}")
                SHM_COUNT=$((SHM_COUNT + 1))
                SHM_LIST="${SHM_LIST:+${SHM_LIST}, }${value} from '${name}'"
                if [ "${bytes}" -gt "${SHM_BYTES}" ]; then
                    SHM_BYTES="${bytes}"
                    SHM_SIZE="${value}"
                    SHM_FROM="${name}"
                fi ;;
            add_host)
                if [[ ! "${value}" =~ ${ADD_HOST_RE} ]]; then
                    run_conf_error "${name}" "${n}" "${text}" \
                        "add_host takes <hostname>:host-gateway, e.g. db.local:host-gateway; addresses are not accepted."
                fi
                adds+=(--add-host="${value}")
                add_run_host "${value}" ;;
            *)
                run_conf_error "${name}" "${n}" "${text}" \
                    "unknown key '${key}'; run.conf accepts shm_size and add_host only." ;;
        esac
    done < "${file}"
    if [ ${#adds[@]} -gt 0 ]; then
        echo "devenv: add-on '${name}' adds: ${adds[*]}" >&2
    fi
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --build)    set_action build; shift ;;
        --update)   set_action update; shift ;;
        --versions) set_action versions; shift ;;
        --open)     FIREWALL="off"; shift ;;
        --nested-sandbox) NESTED="on"; shift ;;
        --with)     if [ $# -lt 2 ] || [ -z "$2" ] || [ "${2#-}" != "$2" ]; then
                        missing_addon_name
                    fi
                    add_addon "$2"; shift 2 ;;
        --with=*)   [ -n "${1#--with=}" ] || missing_addon_name
                    add_addon "${1#--with=}"; shift ;;
        -h|--help)  usage; exit 0 ;;
        --)         shift; break ;;
        -*)         echo "devenv: unknown option '$1'" >&2; usage >&2; exit 1 ;;
        *)          break ;;
    esac
done

# The image a session runs, and the flags that name it. Sorted and deduplicated
# so the same set of add-ons is the same image whatever order the flags came
# in. Names are validated and hold no newlines, so a line-based sort is safe;
# read back in a loop because mapfile needs bash 4.
#
# Names are joined with '_', which ADDON_NAME_RE keeps out of every name. With
# '-' as the separator `--with a-b` and `--with a --with b` were both
# devenv:local-a-b, so a build of one silently replaced the other; with '_'
# they are devenv:local_a-b and devenv:local_a_b. build() uses the same
# separator for the tags along its chain.
SESSION_IMAGE="${IMAGE}"
WITH_FLAGS=""
if [ ${#ADDONS[@]} -gt 0 ]; then
    SORTED=()
    while IFS= read -r name; do
        SORTED+=("${name}")
    done < <(printf '%s\n' "${ADDONS[@]}" | LC_ALL=C sort -u)
    ADDONS=("${SORTED[@]}")
    for name in "${ADDONS[@]}"; do
        SESSION_IMAGE="${SESSION_IMAGE}_${name}"
        WITH_FLAGS="${WITH_FLAGS} --with ${name}"
    done
fi

case "${ACTION}" in
    build)    build --build-arg "AGENTS_REFRESH=$(image_refresh)"; exit 0 ;;
    update)   build --pull \
                  --build-arg "AGENTS_REFRESH=$(date -u +%Y%m%dT%H%M%SZ)"
              exit 0 ;;
    versions) require_docker; require_image
              docker run --rm --entrypoint cat "${SESSION_IMAGE}" /opt/devenv/versions.txt; exit 0 ;;
esac

require_docker
require_image

# The allowlist is bind-mounted as a file. Docker does not check what it is
# being handed: pointed at a directory it mounts the directory, the filter then
# reads nothing, and the container reports an empty allowlist - which sends the
# search towards DNS and the file's contents rather than the mount. Each case
# gets its own message here, before docker is involved.
if [ -L "${ALLOWLIST}" ] && [ ! -e "${ALLOWLIST}" ]; then
    echo "devenv: the allowlist at ${ALLOWLIST} is a broken symlink." >&2
    echo "devenv: it points at $(readlink "${ALLOWLIST}"), which does not exist." >&2
    exit 1
elif [ ! -e "${ALLOWLIST}" ]; then
    echo "devenv: no allowlist at ${ALLOWLIST}" >&2
    echo "devenv: expected allowlist.txt beside the launcher, or" >&2
    echo "devenv: DEVENV_ALLOWLIST_FILE pointing at one." >&2
    exit 1
elif [ -d "${ALLOWLIST}" ]; then
    echo "devenv: the allowlist path ${ALLOWLIST} is a directory, not a file." >&2
    echo "devenv: docker would mount it without complaint and the filter would" >&2
    echo "devenv: come up empty. Point it at allowlist.txt itself." >&2
    exit 1
elif [ ! -f "${ALLOWLIST}" ]; then
    echo "devenv: the allowlist at ${ALLOWLIST} is not a regular file." >&2
    exit 1
elif [ ! -r "${ALLOWLIST}" ]; then
    echo "devenv: the allowlist at ${ALLOWLIST} is not readable." >&2
    echo "devenv: check its permissions and those of the directories above it." >&2
    exit 1
fi

WORKDIR="$(pwd)"
LABEL="devenv=${WORKDIR}"

# One session per directory. Two agents sharing a working tree corrupt each
# other's edits.
if [ -n "$(docker ps -q --filter "label=${LABEL}")" ]; then
    echo "devenv: a session is already running for ${WORKDIR}" >&2
    echo "devenv: use a separate git worktree for a second agent." >&2
    exit 1
fi

# Named on every start: an add-on changes what the session can run, and it is
# chosen per run, so the line is the only record of which ones this one has.
if [ ${#ADDONS[@]} -gt 0 ]; then
    echo "devenv: add-ons this session: ${ADDONS[*]} (image ${SESSION_IMAGE})" >&2
    check_addon_base

    for name in "${ADDONS[@]}"; do
        read_run_conf "${name}"
    done
    if [ -n "${SHM_SIZE}" ]; then
        if [ "${SHM_COUNT}" -gt 1 ]; then
            echo "devenv: add-ons ask for different shm sizes (${SHM_LIST});" >&2
            echo "devenv: using the largest, --shm-size=${SHM_SIZE} from add-on '${SHM_FROM}'." >&2
        fi
        ADDON_RUN+=(--shm-size="${SHM_SIZE}")
    fi
    if [ ${#RUN_HOSTS[@]} -gt 0 ]; then
        for host in "${RUN_HOSTS[@]}"; do
            ADDON_RUN+=(--add-host="${host}")
        done
    fi
fi

# Credential volumes, one per agent. Mounting all three into every session lets
# any agent read the others' tokens, so the volume follows the agent being
# launched. The command decides, not DEVENV_AGENT: that is an identity label,
# and keeping the two apart means `DEVENV_AGENT=claude-review devenv claude`
# still gets Claude's volume and nobody has to think about it.
CREDS=()
case "${1:-}" in
    claude) CREDS=(-v devenv-claude:/home/node/.claude) ;;
    codex)  CREDS=(-v devenv-codex:/home/node/.codex) ;;
    agy)    CREDS=(-v devenv-gemini:/home/node/.gemini) ;;
    *)      CREDS=(-v devenv-claude:/home/node/.claude \
                   -v devenv-codex:/home/node/.codex \
                   -v devenv-gemini:/home/node/.gemini)
            echo "devenv: no agent named, so all three credential volumes are mounted." >&2
            echo "devenv: name one - 'devenv claude', 'devenv codex', 'devenv agy' - to" >&2
            echo "devenv: mount only its own." >&2 ;;
esac

CAPS=()
if [ "${FIREWALL}" = "on" ]; then
    CAPS=(--cap-add=NET_ADMIN --cap-add=NET_RAW)
else
    echo "devenv: starting WITHOUT the egress filter" >&2
fi

# An agent that sandboxes its own shell commands needs user namespaces, which
# docker's default seccomp profile denies. Turning the profile off is the price,
# and it is charged per session on purpose: there is no environment variable for
# this, so it cannot be set once in .env.local and forgotten.
#
# seccomp rather than --cap-add=SYS_ADMIN, which also works: the session's
# process is unprivileged and holds no capabilities, so dropping the syscall
# filter widens the kernel surface it can reach, whereas SYS_ADMIN would hand
# the container a capability that is itself a way out of it.
SECCOMP=()
if [ "${NESTED}" = "on" ]; then
    SECCOMP=(--security-opt seccomp=unconfined)
    echo "devenv: user namespaces enabled; the seccomp filter is OFF this session" >&2
fi

# Resource limits. Unset means unlimited, which is the default: an empty value
# must not reach docker, which rejects '--cpus=' outright.
LIMITS=()
[ -n "${DEVENV_CPUS:-}" ] && LIMITS+=(--cpus="${DEVENV_CPUS}")
[ -n "${DEVENV_PIDS:-}" ] && LIMITS+=(--pids-limit="${DEVENV_PIDS}")

if [ -n "${DEVENV_MEMORY_SWAP:-}" ] && [ -z "${DEVENV_MEMORY:-}" ]; then
    echo "devenv: DEVENV_MEMORY_SWAP is set but DEVENV_MEMORY is not." >&2
    echo "devenv: docker's swap limit is the total of memory plus swap, so it" >&2
    echo "devenv: means nothing without a memory limit to be the total of." >&2
    exit 1
fi

if [ -n "${DEVENV_MEMORY:-}" ]; then
    if ! MEMORY_BYTES="$(to_bytes "${DEVENV_MEMORY}")"; then
        echo "devenv: DEVENV_MEMORY='${DEVENV_MEMORY}' is not a size docker accepts." >&2
        echo "devenv: use a whole number with an optional unit: 8g, 512m, 1024." >&2
        exit 1
    fi

    # Swap defaults to the memory limit, which switches swap off. Docker's own
    # default is to allow the same amount again as swap, so DEVENV_MEMORY=8g
    # would mean 8 GiB of RAM plus 8 GiB of disk - a ceiling that hides
    # thrashing rather than preventing it.
    MEMORY_SWAP="${DEVENV_MEMORY_SWAP:-${DEVENV_MEMORY}}"

    if [ "${MEMORY_SWAP}" != "-1" ]; then
        if ! SWAP_BYTES="$(to_bytes "${MEMORY_SWAP}")"; then
            echo "devenv: DEVENV_MEMORY_SWAP='${MEMORY_SWAP}' is not a size docker accepts." >&2
            echo "devenv: use a whole number with an optional unit (8g, 512m, 1024)," >&2
            echo "devenv: or -1 for unlimited swap." >&2
            exit 1
        fi
        if [ "${SWAP_BYTES}" -lt "${MEMORY_BYTES}" ]; then
            echo "devenv: DEVENV_MEMORY_SWAP (${MEMORY_SWAP}) is below DEVENV_MEMORY (${DEVENV_MEMORY})." >&2
            echo "devenv: the swap limit is the total of memory plus swap, so it can" >&2
            echo "devenv: never be the smaller of the two. Set it equal to" >&2
            echo "devenv: DEVENV_MEMORY for no swap at all, higher to allow that" >&2
            echo "devenv: much in total, or -1 for unlimited." >&2
            exit 1
        fi
    fi

    LIMITS+=(--memory="${DEVENV_MEMORY}" --memory-swap="${MEMORY_SWAP}")
fi

[ ${#LIMITS[@]} -gt 0 ] && echo "devenv: limits: ${LIMITS[*]}" >&2

# SELinux hosts need a relabel option on bind mounts or the container cannot
# read the project directory. Empty by default, which leaves the mount strings
# byte-for-byte as they were.
MOUNT_SUFFIX="${DEVENV_MOUNT_SUFFIX:-}"
if [ -n "${MOUNT_SUFFIX}" ] && [ "${MOUNT_SUFFIX#:}" = "${MOUNT_SUFFIX}" ]; then
    echo "devenv: DEVENV_MOUNT_SUFFIX must start with a colon, e.g. ':z'." >&2
    echo "devenv: without one the value would be glued onto the mount path." >&2
    exit 1
fi

# The allowlist mount already carries an option, and docker separates those
# with commas rather than colons: ':ro,z', not ':ro:z'.
ALLOWLIST_OPTS=":ro${MOUNT_SUFFIX:+,${MOUNT_SUFFIX#:}}"

exec docker run --rm -it --init \
    --label "${LABEL}" \
    --hostname devenv \
    -v "${WORKDIR}:/app${MOUNT_SUFFIX}" \
    "${CREDS[@]}" \
    -v "${ALLOWLIST}:/etc/devenv/allowlist.txt${ALLOWLIST_OPTS}" \
    -e "DEVENV_FIREWALL=${FIREWALL}" \
    -e "DEVENV_AGENT=${DEVENV_AGENT:-}" \
    -e "TERM=${TERM:-xterm-256color}" \
    "${CAPS[@]}" \
    "${SECCOMP[@]}" \
    "${LIMITS[@]}" \
    "${ADDON_RUN[@]}" \
    "${SESSION_IMAGE}" \
    "${@:-bash}"
